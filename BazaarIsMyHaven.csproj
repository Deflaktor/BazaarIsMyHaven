<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="..\libs\**" />
    <EmbeddedResource Remove="..\libs\**" />
    <None Remove="..\libs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
	<PackageReference Include="R2API.Core" Version="5.3.0" />
	<PackageReference Include="R2API.Language" Version="1.1.0" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
	<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8">
      <NoWarn>NU1701</NoWarn>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\ItemStringParser\ItemStringParser.csproj">
		<Private>False</Private>
	</ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="InLobbyConfig">
      <HintPath>..\libs\InLobbyConfig.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ShareSuite">
      <HintPath>..\libs\ShareSuite.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="CHANGELOG.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="newtdialog.language">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="newtwelcome.language">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="manifest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
